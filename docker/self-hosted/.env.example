# Copy to .env and fill in. Values marked "required" have no default.

# ---- Instance ----
# Public address users open, without a trailing slash (required).
SPHERE_URL=https://sphere.example.com
# Release of the sphere-api and sphere-client images. Pin one, e.g. 2.13.0.
SPHERE_VERSION=latest
# Port nginx publishes on the host.
HTTP_PORT=80

# ---- Secrets (required) ----
# Letters and digits only: they go into a connection URL.
# Generate each one with: openssl rand -hex 32
MONGO_ROOT_PASSWORD=
MONGO_PASSWORD=
JWT_SECRET=

# ---- Email (Brevo) ----
# Needed for sign-up: new accounts confirm their address by email.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SPHERE

# ---- Google sign-in (optional) ----
# Authorized redirect URI: <SPHERE_URL>/api/v1/users/auth/sso/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- AI assistants (optional) ----
# ORBIT's chat only needs OPENAI_API_KEY. HARVEY and A-MINT also need the
# ai profile: docker compose --profile ai up -d
OPENAI_API_KEY=
# Any OpenAI-compatible API, such as Ollama or vLLM. Empty: OpenAI.
OPENAI_BASE_URL=
# HARVEY's and ORBIT's model. Empty: gpt-5-nano.
OPENAI_MODEL=
# A-MINT's models. Empty: gpt-5.2.
AMINT_LLM_MODEL=
AMINT_LLM_BETTER_MODEL=

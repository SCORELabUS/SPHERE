# Merge these additions into the existing .env; retain other SPHERE/HARVEY settings.
# This single switch is explicitly passed to both server and nginx.
AUTH_PROVIDER=local
# First deployment: expose /identity while keeping SPHERE login/US callback local.
SCORETECH_IDENTITY_PREVIEW=false
SCORETECH_IDENTITY_UPSTREAM=scoretech-identity-gateway:8080
FRONTEND_URL=https://sphere.score.us.es
SCORETECH_IDENTITY_ISSUER=https://sphere.score.us.es/identity/auth/realms/score
SCORETECH_IDENTITY_CLIENT_ID=
SCORETECH_IDENTITY_CLIENT_SECRET=
SCORETECH_IDENTITY_ACCOUNT_URL=https://sphere.score.us.es/identity/account/
SCORETECH_IDENTITY_TRANSPORT_URL=http://scoretech-identity-gateway:8080/identity/auth/realms/score
# Optional for an explicitly configured public SPHERE callback:
# SCORETECH_IDENTITY_CALLBACK_URL=https://sphere.score.us.es/api/v1/auth/identity/callback

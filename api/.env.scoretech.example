# Merge these entries into your existing API environment. Never commit the secret.
# One runtime switch; the frontend reads it from GET /api/v1/auth/config.
AUTH_PROVIDER=local
FRONTEND_URL=http://localhost:5173
SCORETECH_IDENTITY_ISSUER=http://localhost:18000/identity/auth/realms/score
SCORETECH_IDENTITY_CLIENT_ID=
SCORETECH_IDENTITY_CLIENT_SECRET=
# Optional; defaults to FRONTEND_URL + BASE_URL_PATH + /api/v1/auth/identity/callback
# SCORETECH_IDENTITY_CALLBACK_URL=http://localhost:5173/api/v1/auth/identity/callback
# Optional; derived from the issuer. Opened separately with #public-profile.
# SCORETECH_IDENTITY_ACCOUNT_URL=http://localhost:18000/identity/account/
# Optional private transport to that same realm for Docker networking.
# SCORETECH_IDENTITY_TRANSPORT_URL=http://host.docker.internal:18000/identity/auth/realms/score
